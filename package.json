{
  "name": "saucedemo-playwright",
  "version": "1.0.0",
  "description": "Automation test SauceDemo with Playwright JavaScript",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "allure:generate": "node scripts/allure-helper.js generate",
    "allure:open": "allure open allure-report",
    "allure:serve": "node scripts/allure-helper.js serve"
  },
  "keywords": [
    "playwright",
    "testing",
    "automation",
    "saucedemo"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "allure-commandline": "^2.46.1",
    "allure-playwright": "^3.14.0"
  }
}
